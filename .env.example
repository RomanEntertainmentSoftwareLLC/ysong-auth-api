# YSong Local API
LOCAL_MODE=1
NODE_ENV=development
PORT=8081
FRONTEND_URL=http://127.0.0.1:5173
APP_URL=http://127.0.0.1:5173
DATABASE_URL=postgres://ysong:ysong_local@127.0.0.1:5434/ysong
PGSSL=0
JWT_SECRET=change-this-local-secret-before-sharing
LOCAL_STORAGE_DIR=../data/uploads
MAX_UPLOAD_MB=500
TOS_VERSION=local-v1

# AI is OFF by default so local YSong cannot silently burn token money.
AI_PROVIDER=none
# To enable OpenAI later:
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5.6

# Only needed if LOCAL_MODE=0 and you restore email verification:
# RESEND_API_KEY=
# EMAIL_FROM=YSong <noreply@example.com>

# MiniMax Music 3 is a replaceable generation provider.
# "auto" prefers the proven local audio.cpp GGUF runtime when it exists,
# then falls back to the legacy HTTP/OpenAI-compatible server.
MINIMAX_MUSIC_PROVIDER=auto

# Local Windows audio.cpp defaults (override only if you moved them).
MINIMAX_AUDIOCPP_ROOT=C:\YSong
# MINIMAX_AUDIOCPP_EXE=C:\YSong\audio.cpp-main\build\windows-cuda-release\bin\audiocpp_cli.exe
# MINIMAX_AUDIOCPP_MODEL_DIR=C:\YSong\MiniMax-Music3-GGUF
# MINIMAX_AUDIOCPP_BACKEND=cuda
# MINIMAX_AUDIOCPP_DEVICE=0
MINIMAX_AUDIOCPP_THREADS=4
# Standard local quality uses 10 flow steps; set 30 for final-quality experiments.
MINIMAX_AUDIOCPP_STEPS=10
MINIMAX_AUDIOCPP_GUIDANCE=1.7
MINIMAX_AUDIOCPP_AR_GUIDANCE=1.5
MINIMAX_AUDIOCPP_TIMEOUT_MS=43200000

# Legacy/cloud HTTP provider. Set MINIMAX_MUSIC_PROVIDER=http to force it.
MINIMAX_MUSIC_URL=http://127.0.0.1:8000
MINIMAX_MUSIC_MODEL=minimax_ttm
MINIMAX_MUSIC_TIMEOUT_MS=1200000

# YSong SEO Intelligence managed provider credentials.
# Keep these server-side. Never put them in the web/Vite environment.
# In production these belong to the YSong service account, not end users.
MUSICSEO_YOUTUBE_API_KEY=
MUSICSEO_SPOTIFY_CLIENT_ID=
MUSICSEO_SPOTIFY_CLIENT_SECRET=
MUSICSEO_SPOTIFY_MARKET=US
# Optional provider/query cache tuning (milliseconds).
MUSICSEO_ANALYZE_CACHE_MS=600000
# Optional separate per-user SEO data location. Defaults under LOCAL_STORAGE_DIR/musicseo.
# MUSICSEO_DATA_DIR=../data/musicseo

# Phase 23 Promotion Center creative rendering
# Leave these unset when ffmpeg/ffprobe are on PATH.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
PROMOTION_FFMPEG_PRESET=medium
PROMOTION_FFMPEG_CRF=20
PROMOTION_RENDER_TIMEOUT_MS=600000

# Phase 23 Promotion Center / Meta Graph API
# Keep these ONLY on ysong-auth-api. Never expose them through VITE_* variables.
META_APP_ID=
META_APP_SECRET=
META_TOKEN_ENCRYPTION_KEY=
META_GRAPH_VERSION=v26.0
META_PROMOTION_CTA=LISTEN_NOW
# Public production URLs used for campaign links, OAuth callbacks, and artwork fetched by Meta.
PROMOTION_WEB_BASE_URL=https://ysong.ai
PROMOTION_API_PUBLIC_BASE_URL=
# Optional override when the Meta app has an explicitly registered callback URL.
# META_OAUTH_REDIRECT_URI=https://api.example.com/api/tools/promotion/meta/oauth/callback

# Phase 23.3.1 licensed stock-video search for Ad Creative Studio.
# Keep this server-side. Never expose it through VITE_* variables.
# Pexels: https://www.pexels.com/api/
PEXELS_API_KEY=
# Maximum downloaded stock clip size in bytes. Default: 250 MiB.
# PROMOTION_STOCK_MAX_BYTES=262144000

# Phase 24 Curator Marketplace
# Non-cash courtesy review credits created once per user wallet during beta.
# Set to 0 to disable starter credits. A real purchase provider is intentionally not claimed yet.
CURATOR_BETA_STARTER_CREDITS=10

# Phase 28 Progressive AI Stem Composer — optional target-stem AUDIO provider.
# This must be a provider/model capable of generating the requested stem ONLY while
# conditioning on approved stems/reference material. Do NOT point this at a full-song
# generator and stem-split afterward. Leave blank until a real target-stem model exists.
STEM_AUDIO_PROVIDER_URL=
STEM_AUDIO_PROVIDER_API_KEY=
STEM_AUDIO_PROVIDER_NAME=
STEM_AUDIO_PROVIDER_TIMEOUT_MS=180000
