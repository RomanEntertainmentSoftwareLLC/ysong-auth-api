# YSong Local API
LOCAL_MODE=1
NODE_ENV=development
PORT=8081
FRONTEND_URL=http://127.0.0.1:5173
APP_URL=http://127.0.0.1:5173
DATABASE_URL=postgres://ysong:ysong_local@127.0.0.1:5434/ysong
PGSSL=0
JWT_SECRET=change-this-local-secret-before-sharing
LOCAL_STORAGE_DIR=../data/uploads
MAX_UPLOAD_MB=500
TOS_VERSION=local-v1

# AI is OFF by default so local YSong cannot silently burn token money.
AI_PROVIDER=none
# To enable OpenAI later:
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5.6

# Only needed if LOCAL_MODE=0 and you restore email verification:
# RESEND_API_KEY=
# EMAIL_FROM=YSong <noreply@example.com>

# MiniMax Music 3 local/open-weights server (SGLang-Omni)
# The official model serves the shared /v1/audio/speech API.
MINIMAX_MUSIC_URL=http://127.0.0.1:8000
MINIMAX_MUSIC_MODEL=minimax_ttm
# Full non-streaming songs can take several minutes on local GPUs.
MINIMAX_MUSIC_TIMEOUT_MS=1200000
